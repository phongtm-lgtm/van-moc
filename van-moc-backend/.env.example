# Copy to .env and set your own values. Run the backend from this directory.
# Spring reads this as Java properties: do not wrap values in quotes.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=30000
DB_NAME=van_moc
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/van_moc
DB_USERNAME=van_moc
DB_PASSWORD=replace-with-your-password
FRONTEND_ORIGIN=http://localhost:5173
LOCATION_INIT_MODE=IF_EMPTY
LOCATION_PROVINCES_URL=https://provinces.open-api.vn/api/v2/p/
LOCATION_WARDS_URL=https://provinces.open-api.vn/api/v2/w/
LOCATION_CONNECT_TIMEOUT_MS=5000
LOCATION_READ_TIMEOUT_MS=15000
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:30000/login/oauth2/code/google
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_TTL_SECONDS=3600
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_TIMEOUT=30m
SEPAY_ENABLED=false
ADMIN_ORIGIN=http://localhost:5174
PAYMENT_TIMEOUT_MINUTES=15
SEPAY_WEBHOOK_SECRET=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK=
SESSION_CLEANUP_CRON=0 * * * * *
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=ap-southeast-1
AWS_CLOUDFRONT_URL=
